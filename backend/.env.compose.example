# Copy to backend/.env.compose and replace both placeholders before starting Compose.
APP_ENV=development
POSTGRES_DB=zsme
POSTGRES_USER=zsme
POSTGRES_PASSWORD=replace-me-with-a-local-password
SECRET_KEY=replace-me-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_MINUTES=30
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=30000
REQUEST_BODY_LIMIT_BYTES=1048576
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=300
LOGIN_BLOCK_SECONDS=900
# Optional comma-separated browser origins, for example http://localhost:3000
CORS_ORIGINS=
