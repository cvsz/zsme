# Copy to .env for local API-only development. Replace placeholders locally.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://zsme:replace-me@localhost:5432/zsme
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=30000
SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_MINUTES=30
REQUEST_BODY_LIMIT_BYTES=1048576
# Login abuse controls; tune only with an approved operational policy.
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=300
LOGIN_BLOCK_SECONDS=900
# Comma-separated browser origins. Keep empty unless cross-origin browser access is required.
CORS_ORIGINS=
